{
  "name": "filmcraft",
  "version": "0.1.0-dev.20261018.3",
  "description": "多机位剪辑、字幕、逐词转录、调色与导出；时间线、素材引用与字幕文件一并交付。",
  "author": {
    "name": "Full AIGC Plugins",
    "url": "https://github.com/full-aigc-plugins"
  },
  "homepage": "https://github.com/full-aigc-plugins/filmcraft-plugin",
  "repository": "https://github.com/full-aigc-plugins/filmcraft-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "agent-plugin",
    "filmcraft",
    "creative-workflow",
    "development-release"
  ],
  "skills": "./skills/",
  "displayName": "FilmCraft（视频剪辑）",
  "icon": "./assets/official-logo.png",
  "mcpServers": {
    "filmcraft-editor": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/ui/bootstrap.mjs"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "CRAFT_PANEL_METADATA_FILE": "${ZCODE_PLUGIN_ROOT}/.zcode-plugin/panel-meta.json",
        "CRAFT_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "displayName_i18n": {
    "zh-CN": "FilmCraft（视频剪辑）"
  },
  "ui": {
    "surfaces": [
      {
        "id": "editor",
        "title": {
          "en-US": "FilmCraft (Video Editing)",
          "zh-CN": "FilmCraft（视频剪辑）"
        },
        "icon": "film",
        "server": "filmcraft-editor",
        "resourceUri": "ui://filmcraft/panel.html",
        "availability": "session"
      }
    ]
  },
  "commands": "commands"
}
