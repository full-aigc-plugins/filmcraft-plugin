{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "filmcraft",
  "version": "0.1.0-dev.20261018.3",
  "description": "多机位剪辑、字幕、逐词转录、调色与导出；时间线、素材引用与字幕文件一并交付。",
  "author": {
    "name": "Full AIGC Plugins",
    "url": "https://github.com/full-aigc-plugins"
  },
  "homepage": "https://github.com/full-aigc-plugins/filmcraft-plugin",
  "repository": "https://github.com/full-aigc-plugins/filmcraft-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "agent-plugin",
    "filmcraft",
    "creative-workflow",
    "development-release"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "FilmCraft（视频剪辑）",
        "shortDescription": "多机位、字幕、调色与转录，可重开剪辑工程",
        "longDescription": "Use independently maintained, checksummed skills to install official CLIs and create editable native projects. Development release; complete capability and host acceptance remain in progress.",
        "developerName": "Full AIGC Plugins",
        "category": "Creativity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://github.com/full-aigc-plugins/filmcraft-plugin",
        "defaultPrompt": [
          "Create an editable FilmCraft project from my assets"
        ],
        "logo": "./assets/official-logo.png",
        "logoDark": "./assets/official-logo.png",
        "composerIcon": "./assets/official-logo.png",
        "composerIconDark": "./assets/official-logo.png"
      }
    },
    "ai.nanoco.nanoclaw": {
      "agentName": "FilmCraft"
    }
  }
}
